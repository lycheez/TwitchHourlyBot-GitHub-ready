<Window x:Class="TwitchHourlyBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Twitch Hourly Bot"
        Height="900" Width="1440"
        MinHeight="760" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/TwitchHourlyBot.ico"
        Background="#090A0D"
        Foreground="#F7F7FA">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FF2B45"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#FF7183"/>
        <SolidColorBrush x:Key="AccentDark" Color="#351019"/>
        <SolidColorBrush x:Key="Panel" Color="#13151A"/>
        <SolidColorBrush x:Key="Panel2" Color="#191B21"/>
        <SolidColorBrush x:Key="Panel3" Color="#0E1014"/>
        <SolidColorBrush x:Key="Border" Color="#292C34"/>
        <SolidColorBrush x:Key="Muted" Color="#969AA5"/>
        <SolidColorBrush x:Key="Green" Color="#22D486"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D0F13"/>
            <Setter Property="Foreground" Value="#F7F7FA"/>
            <Setter Property="BorderBrush" Value="#333740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0D0F13"/>
            <Setter Property="Foreground" Value="#F7F7FA"/>
            <Setter Property="BorderBrush" Value="#333740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F7F7FA"/>
            <Setter Property="Background" Value="#191B21"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1C1F25"/>
            <Setter Property="Foreground" Value="#F7F7FA"/>
            <Setter Property="BorderBrush" Value="#343842"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF2B45"/>
            <Setter Property="BorderBrush" Value="#FF2B45"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#291118"/>
            <Setter Property="Foreground" Value="#FF91A0"/>
            <Setter Property="BorderBrush" Value="#5A1D2A"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F7F7FA"/>
        </Style>
    </Window.Resources>

    <!-- Technical values are intentionally kept out of the dashboard UI. -->
    <Grid>
        <Grid x:Name="HiddenAuthFields" Visibility="Collapsed">
            <TextBox x:Name="ClientIdBox"/>
            <PasswordBox x:Name="ClientSecretBox"/>
            <TextBox x:Name="BotUsernameBox"/>
            <TextBox x:Name="BotUserIdBox"/>
            <Button x:Name="LoginButton" Click="DisconnectButton_Click"/>
        </Grid>

        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="52" Height="52" Background="#2A0C13" BorderBrush="#5D1B29" BorderThickness="1" CornerRadius="14" Padding="7">
                        <Image Source="Assets/TwitchHourlyBot.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="Twitch Hourly Bot" FontSize="27" FontWeight="Bold"/>
                        <TextBlock Text="Live monitoring • Chat automation • Event Engine" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#10231B" BorderBrush="#24563F" BorderThickness="1" CornerRadius="18" Padding="12,7" Margin="0,0,9,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ConnectionText" Text="Connected" Foreground="#B8F4D8" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="DisconnectButton" Content="Disconnect" Width="104" Style="{StaticResource DangerButton}" Click="DisconnectButton_Click"/>
                    <Button x:Name="StartButton" Content="▶  Start Bot" Width="122" Style="{StaticResource PrimaryButton}" Click="StartButton_Click"/>
                    <Button x:Name="StopButton" Content="■  Stop" Width="92" IsEnabled="False" Click="StopButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- KPI row -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="MONITORED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSoft}"/>
                        <TextBlock x:Name="ChannelCountText" Text="0 channels • 0 active" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="ช่องที่อยู่ในระบบ" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="AUTOMATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSoft}"/>
                        <TextBlock x:Name="AutomationIntervalText" Text="Every 1 hour" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="ข้อความอัตโนมัติ" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="EVENT ENGINE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSoft}"/>
                        <TextBlock x:Name="EventEngineStateText" Text="READY" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        <TextBlock Text="สุ่มกิจกรรมตามหมวด + cooldown" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#211016" BorderBrush="#4A1A26" BorderThickness="1" CornerRadius="14" Padding="17">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="CONNECTED ACCOUNT" FontSize="10" FontWeight="Bold" Foreground="#FF8191"/>
                            <TextBlock x:Name="AccountNameText" Text="Twitch" FontSize="21" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <TextBlock x:Name="SessionText" Text="Session พร้อมใช้งาน" Foreground="#D4A6AE" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Ellipse Width="9" Height="9" Fill="{StaticResource Green}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Main -->
            <TabControl Grid.Row="2" Margin="0,0,0,18" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="#BFC2CA"/>
                        <Setter Property="Padding" Value="18,9"/>
                        <Setter Property="Margin" Value="0,0,6,0"/>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="◉  Dashboard" Foreground="#F7F7FA">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.15*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CHANNELS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSoft}"/>
                            <TextBlock Text="Live channels &amp; automation" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Add, monitor and control each channel independently" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="1">
                            <TextBox x:Name="NewChannelBox" Height="42" BorderThickness="0" ToolTip="เช่น pgl_dota2 หรือ @pgl_dota2"/>
                        </Border>
                        <Button Grid.Column="1" Content="＋  Add Channel" Width="142" Height="42" Style="{StaticResource PrimaryButton}" Click="AddChannelButton_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChannelList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.55*"/>
                                                <ColumnDefinition Width="0.85*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="0.9*"/>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#666A73"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource Green}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Channel}" FontSize="16" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding LastMessage}" Foreground="{StaticResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="17,4,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Content="Bot ON" VerticalAlignment="Center" Checked="ChannelEnabled_Changed" Unchecked="ChannelEnabled_Changed"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" FontSize="12"/>
                                            <TextBlock Grid.Column="3" Text="{Binding LiveTime}" VerticalAlignment="Center" Foreground="#E0E2E7" FontSize="12"/>
                                            <TextBlock Grid.Column="4" Text="{Binding NextMessage, StringFormat=Next: {0}}" VerticalAlignment="Center" Foreground="#FF9CAA" FontSize="11"/>
                                            <Button Grid.Column="5" Content="⚙ Events" Padding="11,6" Click="EventSettingsButton_Click" Tag="{Binding}"/>
                                            <Button Grid.Column="6" Content="Remove" Style="{StaticResource DangerButton}" Padding="11,6" Click="RemoveChannelButton_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="AUTOMATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSoft}"/>
                    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,8,0,10">
                        <StackPanel>
                            <TextBlock Text="Chat message" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="ส่งข้อความเมื่อ Live ครบทุก N ชั่วโมง" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="MessageTemplateBox" Text="⏰ {channel} Live มาแล้ว {hours} ชั่วโมง! 🎉" Height="40"/>
                                <TextBox x:Name="IntervalBox" Grid.Column="1" Text="1" Height="40" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{}{channel}  {hours}  {minutes}  {live_time}" Foreground="#8F939D" FontSize="10" Margin="0,8,0,0"/>
                            <Border Background="#17191F" BorderBrush="#282B33" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,11,0,0">
                                <TextBlock Text="ไม่ส่งย้อนหลังเมื่อกด Start — รอให้ถึงเส้นเวลา Live จริงก่อน" Foreground="#B8BBC4" FontSize="10" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="#1E1015" BorderBrush="#4B1A25" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="REST &amp; WELLNESS" FontSize="17" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ActivityEnabledBox" Content="ON" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FFB2BC"/>
                            </Grid>
                            <TextBlock Text="Event Engine • สุ่มข้อความตามหมวด + cooldown" Foreground="#C89AA2" FontSize="11" Margin="0,4,0,10"/>
                            <TextBlock Text="💧 น้ำ    👀 สายตา    💪 ยืด    😮‍💨 ผ่อนคลาย    💜 กำลังใจ" Foreground="#E5C4C9" FontSize="11" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ActivityNextText" Text="Next event: -" Foreground="#FF899A" FontSize="11" Margin="0,10,0,0"/>
                            <TextBlock x:Name="EventEngineStateText2" Text="" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="ACTIVITY LOG" FontSize="17" FontWeight="SemiBold"/>
                            <ListBox x:Name="ActivityLogList" Grid.Row="1" Margin="0,10,0,10" Background="#0D0F13" BorderBrush="#282B33" Foreground="#DADDE4" FontSize="11"/>
                            <TextBlock Grid.Row="2" Text="กิจกรรมล่าสุดของ session นี้" Foreground="#70747E" FontSize="10"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
                </TabItem>

                <TabItem Header="🛡  Keyword Timeout">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CHANNELS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSoft}"/>
                                    <TextBlock Text="Keyword Protection" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                    <TextBlock Text="เลือกช่องเพื่อจัดการคำต้องห้ามแยกกัน" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ListBox x:Name="KeywordChannelList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#F7F7FA" SelectionChanged="KeywordChannelList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10" Margin="0,0,0,6" Background="#191B21" CornerRadius="9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Channel}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding KeywordSummary}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#666A73"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding KeywordProtectionEnabled}" Value="True"><Setter Property="Fill" Value="{StaticResource Green}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="KEYWORD TIMEOUT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSoft}"/>
                                        <TextBlock x:Name="KeywordChannelTitle" Text="เลือก Channel" FontSize="24" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        <TextBlock Text="ถ้าข้อความมีคำที่เปิดใช้งานอยู่ ผู้ใช้จะถูก Timeout อัตโนมัติ" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="KeywordProtectionEnabledBox" Content="PROTECTION ON" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="#B8F4D8" IsChecked="True" Checked="KeywordProtectionEnabled_Changed" Unchecked="KeywordProtectionEnabled_Changed"/>
                                </Grid>

                                <Border Grid.Row="1" Background="#0E1014" BorderBrush="#292C34" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewKeywordBox" Height="40" ToolTip="เช่น เนเน่"/>
                                        <ComboBox x:Name="NewKeywordTimeoutBox" Grid.Column="1" Height="40" Margin="8,0,0,0" SelectedIndex="0">
                                            <ComboBoxItem Content="60 sec" Tag="60"/>
                                            <ComboBoxItem Content="30 sec" Tag="30"/>
                                            <ComboBoxItem Content="120 sec" Tag="120"/>
                                            <ComboBoxItem Content="300 sec" Tag="300"/>
                                        </ComboBox>
                                        <Button Grid.Column="2" Content="＋ Add Keyword" Width="130" Height="40" Style="{StaticResource PrimaryButton}" Click="AddKeywordButton_Click"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="KeywordRuleList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#191B21" BorderBrush="#292C34" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Keyword}" FontSize="15" FontWeight="SemiBold"/>
                                                            <TextBlock Text="Contains" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" Height="36" SelectedValue="{Binding TimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" SelectionChanged="KeywordTimeout_SelectionChanged">
                                                            <ComboBoxItem Content="30 sec" Tag="30"/>
                                                            <ComboBoxItem Content="60 sec" Tag="60"/>
                                                            <ComboBoxItem Content="120 sec" Tag="120"/>
                                                            <ComboBoxItem Content="300 sec" Tag="300"/>
                                                        </ComboBox>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <CheckBox Content="ON" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Checked="KeywordRuleEnabled_Changed" Unchecked="KeywordRuleEnabled_Changed" Margin="12,0,8,0"/>
                                                            <Button Content="Remove" Style="{StaticResource DangerButton}" Padding="10,6" Click="RemoveKeywordButton_Click" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="KeywordEmptyText" Grid.Row="3" Text="ยังไม่มีคำต้องห้ามสำหรับ Channel นี้" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="พร้อมใช้งาน" Foreground="{StaticResource Muted}" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="OAuth session • encrypted on this Windows account" Foreground="#666A74" FontSize="10" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="Save Settings" Width="120" Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
