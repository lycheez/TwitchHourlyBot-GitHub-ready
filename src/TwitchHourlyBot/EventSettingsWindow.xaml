<Window x:Class="TwitchHourlyBot.EventSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Engine Settings" Width="920" Height="720"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0E0E10" Foreground="#F1F1F3">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#18181B"/>
        <SolidColorBrush x:Key="Panel2" Color="#1F1F23"/>
        <SolidColorBrush x:Key="Border2" Color="#2B2B31"/>
        <SolidColorBrush x:Key="Muted" Color="#A7A7AD"/>
        <SolidColorBrush x:Key="Purple" Color="#9147FF"/>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111113"/><Setter Property="Foreground" Value="#F1F1F3"/>
            <Setter Property="BorderBrush" Value="#34343A"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#111113"/>
            <Setter Property="Foreground" Value="#F1F1F3"/>
            <Setter Property="Padding" Value="8,7"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#351019"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF2B45"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#666A73"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111113"/>
            <Setter Property="Foreground" Value="#F1F1F3"/>
            <Setter Property="BorderBrush" Value="#34343A"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource {x:Type ComboBoxItem}}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#29292E"/><Setter Property="Foreground" Value="#F1F1F3"/>
            <Setter Property="BorderBrush" Value="#3A3A40"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#9147FF"/><Setter Property="BorderBrush" Value="#9147FF"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="EVENT ENGINE" FontSize="12" FontWeight="Bold" Foreground="#BFA8FF"/>
                <TextBlock x:Name="TitleText" Text="Channel Event Settings" FontSize="25" FontWeight="Bold" Margin="0,3,0,0"/>
                <TextBlock Text="สุ่มข้อความพักผ่อนแบบแยกหมวด + cooldown ต่อช่อง" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="ทุก" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="GlobalIntervalBox" Width="55" Text="30"/>
                <TextBlock Text="นาที" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,12,0"/>
                <CheckBox x:Name="GlobalEnabledBox" Content="เปิด Event Engine" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border2}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="THIS CHANNEL" FontSize="11" FontWeight="Bold" Foreground="#BFA8FF"/>
                        <TextBlock x:Name="ChannelNameText" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,4"/>
                        <CheckBox x:Name="ChannelEnabledBox" Content="เปิด Event สำหรับช่องนี้" Margin="0,5,0,14"/>
                        <TextBlock Text="หมวดข้อความ" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="เปิด/ปิด และกำหนด cooldown แยกแต่ละหมวด" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,10"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CategoryPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border2}" BorderThickness="1" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="MESSAGE LIBRARY" FontSize="11" FontWeight="Bold" Foreground="#BFA8FF"/>
                        <TextBlock Text="ข้อความที่ Event Engine สุ่มใช้" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,3"/>
                        <TextBlock x:Name="MessageCountText" Foreground="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                    <ListBox x:Name="MessageList" Grid.Row="1" Margin="0,12,0,12" Background="#111113" BorderBrush="#2D2D32" Foreground="#F1F1F3"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="CategoryBox"/>
                        <TextBox x:Name="NewMessageBox" Grid.Column="1" Margin="8,0,0,0" Height="38" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="＋ Add" Width="82" Height="38" Style="{StaticResource PrimaryButton}" Click="AddMessage_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Cooldown คือเวลาขั้นต่ำก่อนหมวดเดิมจะถูกสุ่มอีกครั้งในช่องนี้" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Click="Cancel_Click"/>
                <Button Content="Save" Width="100" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
