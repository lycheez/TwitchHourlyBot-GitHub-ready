<Window x:Class="TwitchHourlyBot.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Twitch Hourly Bot • Login"
        Height="720" Width="1120"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/TwitchHourlyBot.ico"
        Background="#090A0D"
        Foreground="#F7F7FA">
    <Window.Resources>
        <SolidColorBrush x:Key="Red" Color="#FF2B45"/>
        <SolidColorBrush x:Key="RedDark" Color="#8F1428"/>
        <SolidColorBrush x:Key="Panel" Color="#13151A"/>
        <SolidColorBrush x:Key="Panel2" Color="#191B21"/>
        <SolidColorBrush x:Key="Border" Color="#292C34"/>
        <SolidColorBrush x:Key="Muted" Color="#969AA5"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D0F13"/>
            <Setter Property="Foreground" Value="#F7F7FA"/>
            <Setter Property="BorderBrush" Value="#333740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0D0F13"/>
            <Setter Property="Foreground" Value="#F7F7FA"/>
            <Setter Property="BorderBrush" Value="#333740"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2B45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2B45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="36">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="0.85*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="24,0,80,0">
            <Image Source="Assets/TwitchHourlyBot.png" Width="132" Height="132" HorizontalAlignment="Left" Margin="0,0,0,26"/>
            <TextBlock Text="Twitch Hourly Bot" FontSize="42" FontWeight="Bold"/>
            <TextBlock Text="Smart Twitch automation, built around your stream." FontSize="17" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
            <TextBlock Text="Live monitoring • Automated chat • Event Engine" FontSize="13" Foreground="#C7CAD2" Margin="0,7,0,0"/>
            <Border Background="#241015" BorderBrush="#4B1A24" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,28,0,0">
                <StackPanel>
                    <TextBlock Text="SECURE SESSION" FontSize="10" FontWeight="Bold" Foreground="#FF8EA0"/>
                    <TextBlock Text="Login ครั้งแรกครั้งเดียว แล้วโปรแกรมจะจำ Twitch session ให้โดยอัตโนมัติ" FontSize="13" Foreground="#E7E8ED" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="20" Padding="34" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="WELCOME BACK" FontSize="11" FontWeight="Bold" Foreground="#FF7183"/>
                <TextBlock Text="Connect your Twitch account" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/>
                <TextBlock Text="กรอกข้อมูล Twitch Developer Application ของคุณเพื่อเริ่มใช้งาน" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,24"/>

                <TextBlock Text="Client ID" FontSize="12" Foreground="#C5C8D0"/>
                <TextBox x:Name="ClientIdBox" Margin="0,6,0,16"/>

                <TextBlock Text="Client Secret" FontSize="12" Foreground="#C5C8D0"/>
                <PasswordBox x:Name="ClientSecretBox" Margin="0,6,0,20"/>

                <Button x:Name="LoginButton" Content="Continue with Twitch  →" Height="48" Click="LoginButton_Click" Style="{StaticResource LoginButtonStyle}"/>
                <TextBlock x:Name="StatusText" Text="พร้อมเชื่อมต่อ Twitch" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>

                <Border Background="#101217" BorderBrush="#252832" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,22,0,0">
                    <TextBlock Text="Redirect URI ที่ต้องตั้งใน Twitch Developer Console:&#10;http://localhost:37821/callback/" Foreground="#9EA2AD" FontSize="11" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
